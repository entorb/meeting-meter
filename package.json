{
  "name": "meeting-meter",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "run": "run-s build preview",
    "test": "vitest --watch=false",
    "test-cov": "vitest --watch=false --coverage",
    "cy:run": "cypress run --e2e",
    "cy:open": "cypress open --e2e",
    "types": "vue-tsc --build",
    "lint": "eslint . --cache --fix --ignore-pattern .gitignore",
    "format": "biome check --write .",
    "spell": "cspell --cache --quiet \"src/**/*.{txt,md,html,js,ts,vue,json,yml,py}\"",
    "spell-store": "cspell --cache --quiet --words-only --unique \"src/**/*.{txt,md,html,js,ts,vue,json,yml,py}\" > cspell-unknown-words.txt",
    "check": "run-p format lint types spell test knip",
    "knip": "knip"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.0.3",
    "quasar": "^2.32.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@quasar/vite-plugin": "^2.0.2",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "cspell": "^10.3.2",
    "cypress": "^16.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-vue": "~10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "npm-run-all2": "^9.0.3",
    "sass-embedded": "^1.104.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.5.1"
}
